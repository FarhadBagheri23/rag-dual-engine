# Any OpenAI-compatible endpoint. Copy to .env and fill in LLM_API_KEY.
#
#   AvalAI   https://api.avalai.ir/v1        gpt-4o-mini, claude-*, gemini-*
#   Groq     https://api.groq.com/openai/v1  llama-3.3-70b-versatile
#   Gemini   https://generativelanguage.googleapis.com/v1beta/openai/  gemini-2.0-flash
#   Ollama   http://localhost:11434/v1       llama3.2   (LLM_API_KEY=ollama)
#
# GET /api/models lists what your key can actually reach — use it to confirm
# the base URL is right and to populate the model picker in the UI.
LLM_API_KEY=
LLM_BASE_URL=https://api.avalai.ir/v1
LLM_MODEL=gpt-4o-mini

# Embeddings run locally on CPU and need no key, so semantic retrieval works
# without a provider — only the generated answer does.

# --- auth ---
# Required. The app refuses to start without it, rather than falling back to a
# committed default that would ship an auth bypass. Generate your own:
#
#   python -c "import secrets; print(secrets.token_hex(32))"
#
JWT_SECRET=
ACCESS_TOKEN_MINUTES=30
REFRESH_TOKEN_DAYS=7

# The one admin, seeded at startup if that email holds no account yet.
# POST /api/auth/register always creates role='client' — there is no HTTP path
# that can mint an admin, so this is the only way one exists.
ADMIN_EMAIL=admin@mir.local
ADMIN_PASSWORD=
